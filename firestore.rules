// ═══════════════════════════════════════════════════════════════════════
// REGLAS DE SEGURIDAD FIRESTORE - Lucasports
// ═══════════════════════════════════════════════════════════════════════
// Cópialas y pégalas en: Firebase Console → Firestore Database → Rules
// URL: https://console.firebase.google.com/project/_/firestore/rules
// ═══════════════════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Productos: lectura pública, escritura abierta (MVP sin auth)
    match /productos/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Slides del hero: lectura pública, escritura abierta (MVP)
    match /banners_hero/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Configuración (banner publicitario, etc.): lectura pública, escritura abierta
    match /config/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Todo lo demás: bloqueado por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ═══════════════════════════════════════════════════════════════════════
// NOTA DE SEGURIDAD:
// "allow write: if true" permite que cualquiera con la URL del sitio
// escriba en Firestore. Esto es aceptable en MVP porque el panel /admin
// exige contraseña en el cliente, pero un usuario técnico podría escribir
// desde consola. Para producción real, migra a Firebase Auth y usa
// "allow write: if request.auth != null && request.auth.token.admin == true".
// ═══════════════════════════════════════════════════════════════════════
